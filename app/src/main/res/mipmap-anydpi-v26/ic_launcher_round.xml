<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the centre 72 of these 108 units is guaranteed to survive the system's
  mask. The picture sits at 88% and nudged up slightly: full bleed loses the
  ears to a circular mask, and shrinking it into the safe zone leaves a blue
  border that reads as a sticker rather than an icon.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
