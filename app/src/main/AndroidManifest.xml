<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The overlay is the app: it draws the controls over the game, and it is
         also the only window that can see a gamepad while the game is in
         front, because Android delivers key events to the focused window and
         nothing else. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="thorpad"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|density|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keeps the overlay alive while a game is in front. Without it the
             window goes away the moment the app is backgrounded, which is
             exactly when it is needed. -->
        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-screen gamepad controls drawn over other apps" />
        </service>

        <!-- Only ever used for dispatchGesture. It reads nothing about what is
             on screen. -->
        <service
            android:name=".TapService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>
    </application>
</manifest>
